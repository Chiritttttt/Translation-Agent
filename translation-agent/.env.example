# ═══════════════════════════════════════════════════════════
# Translation Agent - Environment Configuration
# ═══════════════════════════════════════════════════════════
#
# Copy this file to .env in the same directory as TranslationAgent.exe
# and fill in your values.
#
# ═══════════════════════════════════════════════════════════

# ── OpenAI-compatible API Configuration ──

# Required: Your API key
OPENAI_API_KEY=sk-your-key-here

# Optional: API base URL (for custom / proxy endpoints)
# Examples:
#   https://api.openai.com/v1           (OpenAI official)
#   https://api.deepseek.com/v1         (DeepSeek)
#   https://open.bigmodel.cn/api/paas/v4 (Zhipu/GLM)
#   http://localhost:8080/v1            (Local proxy / Ollama)
OPENAI_BASE_URL=

# Optional: Model name (default: deepseek-chat)
# Examples:
#   gpt-4o          (OpenAI)
#   gpt-4o-mini     (OpenAI, cheaper)
#   deepseek-chat   (DeepSeek)
#   glm-4-flash     (Zhipu)
OPENAI_MODEL=deepseek-chat

# ── Advanced Settings ──

# Optional: Custom temperature for AI calls (0.0 - 2.0)
# Lower = more deterministic, Higher = more creative
# OPENAI_TEMPERATURE=0.3

# Optional: Max tokens for API responses
# OPENAI_MAX_TOKENS=4096

# Optional: Request timeout in seconds
# OPENAI_TIMEOUT=60

# Optional: Log level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO
